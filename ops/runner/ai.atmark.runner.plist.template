<?xml version="1.0" encoding="UTF-8"?>
<!-- 자체 실행기 LaunchAgent — setup.sh 가 __HOME__ 을 채워 ~/Library/LaunchAgents/ai.atmark.runner.plist 로 설치한다.
     로그인하면 supervise.sh 가 colima 프로필을 켜고 실행기 컨테이너를 띄운다. 런북: docs/runbooks/ci-cd.md §11 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.atmark.runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.atmark-runner/supervise.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ExitTimeOut</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/atmark-runner/supervise.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/atmark-runner/supervise.log</string>
</dict>
</plist>
