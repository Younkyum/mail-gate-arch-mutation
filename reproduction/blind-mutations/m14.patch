+/** `src/outbox/flush.ts` — scheduled drain of stuck `pending` outbound rows. */
+export async function composeOutboxFlush(platform: RuntimePlatform): Promise<Composed<OutboxFlushDependencies>> {
+  const runtime = runtimeOf(platform);
+  const configurationSet = configurationSetOf(runtime);
+  const objects = mailObjects(runtime, s3Of(runtime));
+  const pool = await openPool(runtime, RUNTIME_ENV.dbSecretArn, DB_POOL_MAX);
+  return withPool(pool, () => {
+    const attachments = attachmentsOf(runtime, pool);
+    const content = createObjectContentStore(objects, attachments.objects);
+    return { transport: agentTransportOf(runtime, pool, content, configurationSet), pool };
+  });
+}
