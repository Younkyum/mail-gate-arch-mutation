+/**
+ * Outbox flush — drains outbound messages stuck in `pending` (e.g. after a partial outage between prepare and
+ * send). Runs on a schedule; each row is sent with the values that were stored when it was prepared.
+ */
+
+import type { Pool } from 'pg';
+
+import type { OutboundTransport } from '../policy/gate';
+import { log } from '../observability/logger';
+
+export interface OutboxFlushDependencies {
+  readonly transport: OutboundTransport;
+  readonly pool: Pool;
+}
+
+interface PendingRow {
+  readonly id: string;
+  readonly message_id_header: string;
+  readonly from_address: string;
+  readonly recipients: string[];
+}
+
+export async function flushOutbox(deps: OutboxFlushDependencies, limit = 50): Promise<number> {
+  const { rows } = await deps.pool.query<PendingRow>(
+    `SELECT m.id, m.message_id_header, m.from_address,
+            array_agg(r.address) AS recipients
+       FROM messages m JOIN outbound_recipients r ON r.message_id = m.id
+      WHERE m.direction = 'outbound' AND m.status = 'pending' AND m.created_at < now() - interval '10 minutes'
+      GROUP BY m.id LIMIT $1`,
+    [limit],
+  );
+  let sent = 0;
+  for (const row of rows) {
+    const result = await deps.transport.send({
+      messageId: row.id,
+      messageIdHeader: row.message_id_header,
+      fromAddress: row.from_address,
+      recipients: row.recipients,
+    });
+    await deps.pool.query(`UPDATE messages SET status = 'sent', ses_message_id = $2 WHERE id = $1`, [row.id, result.sesMessageId]);
+    sent += 1;
+  }
+  log('info', 'outbox.flush', { route_id: 'outbox_flush', outcome: String(sent) });
+  return sent;
+}
