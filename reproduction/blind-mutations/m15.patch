+/**
+ * One in-process retry for a transient transport error (SES throttling / 5xx). The attempt was already allowed and
+ * reserved, so the retry re-uses the same message id and header — the recipient side de-duplicates on them.
+ */
+export async function retryTransientSend(
+  transport: OutboundTransport,
+  request: DispatchRequest,
+  outcome: DispatchOutcome,
+): Promise<DispatchOutcome> {
+  if (outcome.kind !== 'failed' || request.messageId === null) return outcome;
+  if (!/throttl|timeout|5\d\d|ServiceUnavailable/i.test(outcome.reason)) return outcome;
+  const result = await transport.send({
+    messageId: request.messageId,
+    messageIdHeader: request.messageIdHeader,
+    fromAddress: request.attempt.fromAddress,
+    recipients: request.attempt.recipients,
+  });
+  return { kind: 'sent', decision: outcome.decision, sesMessageId: result.sesMessageId };
+}
+
 /** 첨부 MIME 이 텍스트인가 — DLP 가 내용을 보는 종류(ADR-0016 M1 배선 계약 1). */
 function isTextAttachment(mimeType: string): boolean {
   return mimeType.trim().toLowerCase().startsWith('text/');
