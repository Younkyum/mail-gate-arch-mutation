+/**
+ * Agent auto-reply (out-of-office). When an agent has an auto-reply message configured, the inbound sender
+ * gets that text back once per thread.
+ */
+
+import { randomUUID } from 'node:crypto';
+
+import { createMailClient, createMailSender, type MailClient } from '../mail/outbound';
+
+export interface AutoReplySettings {
+  readonly agentAddress: string;
+  readonly subject: string;
+  readonly text: string;
+}
+
+export async function sendAutoReply(
+  settings: AutoReplySettings,
+  inboundSender: string,
+  client: MailClient = createMailClient(),
+): Promise<string> {
+  const sender = createMailSender({
+    client,
+    content: { load: () => Promise.resolve({ subject: settings.subject, text: settings.text, html: null, threading: null }) },
+  });
+  const messageId = randomUUID();
+  const result = await sender.send({
+    messageId,
+    messageIdHeader: `<${messageId}@atmark.ai>`,
+    fromAddress: settings.agentAddress,
+    recipients: [inboundSender],
+  });
+  return result.sesMessageId;
+}
