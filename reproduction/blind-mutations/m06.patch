+/**
+ * Templated one-off mail through the welcome surface (same From-header checks, no warm-up cap). Used for
+ * server-rendered announcements that don't need the gate's approval round-trip.
+ */
+export async function sendTemplatedMail(
+  client: SesSendClient,
+  mail: { readonly fromAddress: string; readonly toAddress: string; readonly subject: string; readonly text: string },
+): Promise<string> {
+  const transport = createSesNotificationTransport({ client });
+  const { sesMessageId } = await transport.sendOwnerNotification({
+    notificationId: randomUUID(),
+    fromAddress: mail.fromAddress,
+    toAddress: mail.toAddress,
+    subject: mail.subject,
+    text: mail.text,
+  });
+  return sesMessageId;
+}
