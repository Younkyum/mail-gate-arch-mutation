@@ -0,0 +1,28 @@
+/**
+ * `POST /v1/messages/plain` — plain-text quick send for agents (no attachments, no threading).
+ */
+
+import { SendEmailCommand, SESv2Client } from '@aws-sdk/client-sesv2';
+
+import { jsonResponse, type ApiRequest, type ApiResponse } from '../http';
+import { preflight, type OutboundRouteDependencies } from '../route-context';
+
+const SEND_PLAIN_ROUTE_ID = 'send_plain';
+
+const ses = new SESv2Client({ region: 'ap-northeast-2' });
+
+export async function handleSendPlain(deps: OutboundRouteDependencies, request: ApiRequest): Promise<ApiResponse> {
+  const pre = await preflight(deps, request, SEND_PLAIN_ROUTE_ID, false);
+  if (pre.kind === 'error') return pre.response;
+  const { fromAddress, recipients, subject, text } = pre.request;
+
+  const output = await ses.send(
+    new SendEmailCommand({
+      FromEmailAddress: fromAddress,
+      Destination: { ToAddresses: [...recipients] },
+      ConfigurationSetName: 'atmark-default',
+      Content: { Simple: { Subject: { Data: subject }, Body: { Text: { Data: text } } } },
+    }),
+  );
+  return jsonResponse(202, { status: 'sent', ses_message_id: output.MessageId ?? null });
+}
