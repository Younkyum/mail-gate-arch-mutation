{
  "name": "atmark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:arch && pnpm test:int",
    "test:unit": "vitest run --project unit",
    "test:arch": "vitest run --project arch",
    "test:sdk": "vitest run --project sdk",
    "test:sdk-python": "python3 -m unittest discover -s sdk/python/tests -t sdk/python/tests",
    "sdk:build": "tsx scripts/sdk/build.ts",
    "sdk:verify": "tsx scripts/sdk/verify.ts",
    "test:int": "ATMARK_TEST_DB_CLEANUP=1 vitest run --project integration --project integration-tlog --maxWorkers=2",
    "test:mod": "ATMARK_TEST_DB_CLEANUP=1 tsx test/run-modules.ts",
    "test:changed": "ATMARK_TEST_DB_CLEANUP=1 tsx test/run-modules.ts --changed",
    "test:core": "pnpm test:mod --core && python3 -m unittest discover -s sdk/python/tests -t sdk/python/tests -p \"test_[cwr]*.py\"",
    "test:watch": "vitest",
    "arch:deps": "depcruise src --config .dependency-cruiser.cjs",
    "build:lambda": "tsx scripts/build-lambda.ts",
    "ai-watch:selftest": "tsx ops/ai-watch/test/golden.ts",
    "ai-watch:bundle": "tsx ops/ai-watch/build.ts",
    "ai-watch:e2e": "tsx ops/ai-watch/test/e2e.ts",
    "cdk:synth": "AWS_PROFILE=atmark pnpm exec cdk synth",
    "cdk:diff": "AWS_PROFILE=atmark pnpm exec cdk diff",
    "cdk:deploy": "AWS_PROFILE=atmark pnpm exec cdk deploy",
    "check:dns": "tsx scripts/check-dns.ts",
    "check:ses-region": "tsx scripts/check-ses-inbound-region.ts",
    "check:domain-expiry": "tsx scripts/check-domain-expiry.ts",
    "psl:update": "tsx scripts/update-psl.ts",
    "parse:dmarc-rua": "tsx scripts/parse-dmarc-rua.ts",
    "placement:collect": "tsx scripts/placement-collect.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "smoke:prod": "tsx scripts/smoke-prod.ts",
    "test:coverage": "rm -rf node_modules/.cache/atmark-test/blob && ATMARK_COVERAGE_PARTIAL=1 pnpm test:unit --coverage --reporter=default --reporter=blob --outputFile.blob=node_modules/.cache/atmark-test/blob/unit.json && ATMARK_COVERAGE_PARTIAL=1 pnpm test:arch --coverage --reporter=default --reporter=blob --outputFile.blob=node_modules/.cache/atmark-test/blob/arch.json && ATMARK_COVERAGE_PARTIAL=1 ATMARK_TEST_DB_CLEANUP=1 pnpm test:int --coverage --reporter=default --reporter=blob --outputFile.blob=node_modules/.cache/atmark-test/blob/integration.json && vitest run --merge-reports=node_modules/.cache/atmark-test/blob --coverage",
    "mutations": "tsx test/arch/mutations/run-mutations.ts",
    "demo:p1a": "tsx scripts/demo-p1a.ts",
    "demo:p1b": "tsx scripts/demo-p1b.ts",
    "demo:p1c": "tsx scripts/demo-p1c.ts",
    "demo:p2": "tsx scripts/demo-p2.ts",
    "demo:p3": "tsx scripts/demo-p3.ts",
    "check:ac0": "tsx scripts/check-ac0.ts",
    "ac0:start": "tsx scripts/ac0-start.ts",
    "ac0:forwarding": "tsx scripts/ac0-forwarding.ts",
    "ac0:intervention": "tsx scripts/ac0-intervention.ts",
    "ac0:restart": "tsx scripts/ac0-restart.ts",
    "ac0:probe": "tsx scripts/ac0-probe.ts",
    "sender:mark": "tsx scripts/sender-mark.ts",
    "admin:db-env": "tsx scripts/admin/db-env.ts",
    "admin:dc-pubkey": "tsx scripts/admin/dc-pubkey.ts",
    "admin:org-create": "tsx scripts/admin/org-create.ts",
    "admin:agent-provision": "tsx scripts/admin/agent-provision.ts",
    "admin:agent-token": "tsx scripts/admin/agent-token.ts",
    "admin:reserved-address": "tsx scripts/admin/reserved-address.ts",
    "admin:rules": "tsx scripts/admin/rules.ts",
    "admin:policy": "tsx scripts/admin/policy.ts",
    "admin:policy-request": "tsx scripts/admin/policy-request.ts",
    "admin:agent-delete": "tsx scripts/admin/agent-delete.ts",
    "admin:policy-attachment-default": "tsx scripts/admin/policy-attachment-default.ts",
    "admin:kill-switch": "tsx scripts/admin/kill-switch.ts",
    "admin:org-review": "tsx scripts/admin/org-review.ts",
    "admin:waitlist": "tsx scripts/admin/waitlist.ts",
    "admin:plan": "tsx scripts/admin/plan.ts",
    "admin:ops-operator": "tsx scripts/admin/ops-operator.ts",
    "admin:domain": "tsx scripts/admin/domain.ts",
    "admin:feature": "tsx scripts/admin/feature.ts",
    "admin:web": "tsx scripts/admin/web.ts",
    "admin:redteam-export": "tsx scripts/admin/redteam-export.ts",
    "ops": "tsx scripts/admin/ops.ts",
    "log:verify": "tsx scripts/log-verify.ts",
    "ui:preview": "tsx scripts/ui/preview.ts",
    "ui:shots": "tsx scripts/ui/shots.ts",
    "ui:docs": "tsx scripts/ui/docs-preview.ts",
    "ui:ops": "tsx scripts/ui/ops-preview.ts",
    "gen:fonts": "tsx scripts/gen-fonts.ts",
    "gen:images": "tsx scripts/gen-images.ts",
    "gen:photos": "tsx scripts/gen-photos.ts",
    "gen:docs": "tsx scripts/gen-docs.ts",
    "gen:docs-shots": "tsx scripts/gen-docs-shots.ts",
    "gen:blog": "tsx scripts/gen-blog.ts",
    "gen:blog-images": "tsx scripts/gen-blog-images.ts",
    "gen:pdf-cmaps": "tsx scripts/gen-pdf-cmaps.ts"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "3.1141.0",
    "@aws-sdk/client-cloudfront": "3.1141.0",
    "@aws-sdk/client-kms": "3.1141.0",
    "@aws-sdk/client-lambda": "3.1141.0",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/client-secrets-manager": "3.1141.0",
    "@aws-sdk/client-sesv2": "^3.1137.0",
    "@aws-sdk/client-sqs": "3.1141.0",
    "@aws-sdk/client-ssm": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "imapflow": "^1.0.0",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.0",
    "postal-mime": "4.0.0"
  },
  "devDependencies": {
    "@noble/ed25519": "3.2.0",
    "@scure/base": "2.4.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.270.0",
    "canonicalize": "5.1.0",
    "constructs": "^10.8.1",
    "dependency-cruiser": "^16.9.0",
    "did-resolver": "6.0.0",
    "esbuild": "0.28.2",
    "jose": "6.2.15",
    "pretendard": "1.3.9",
    "ts-morph": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "web-did-resolver": "3.2.0"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": "1.2.2"
    },
    "ignoredOptionalDependencies": [
      "@napi-rs/canvas"
    ]
  }
}
